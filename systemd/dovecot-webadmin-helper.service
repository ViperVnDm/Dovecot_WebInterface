[Unit]
Description=Dovecot Web Admin Privileged Helper
After=network.target

[Service]
Type=exec
User=root
# Group=dwa-web so systemd creates /run/dovecot-webadmin/ as root:dwa-web
# (with RuntimeDirectoryMode=0750), allowing the web app — which runs as
# dwa-web — to traverse into the dir and reach the helper socket. Not
# www-data: that account is shared with nginx and PHP-FPM. The process still
# has EUID=0 so all privileged subprocesses (useradd, chpasswd, ufw, ...)
# work normally.
Group=dwa-web
WorkingDirectory=/opt/dovecot-webadmin
EnvironmentFile=-/opt/dovecot-webadmin/.env
# The helper is stdlib-only, so it runs on the system interpreter in isolated
# mode (-I): no PYTHON* env vars, no cwd or user site-packages on sys.path.
# Nothing the web app's dependencies or a stray .py file in the install dir
# can do will execute as root.
ExecStart=/usr/bin/python3 -I /opt/dovecot-webadmin/privileged/server.py
Restart=always
RestartSec=5

# Runtime directory for socket
RuntimeDirectory=dovecot-webadmin
RuntimeDirectoryMode=0750

# Security hardening — the helper still needs root for useradd/userdel,
# chpasswd, ufw, doveadm, and reading mail logs. Lock down everything else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Filesystem — /usr, /boot, /efi read-only (the helper never writes there).
# Note: ProtectSystem=full would *also* make /etc read-only, breaking
# useradd / chpasswd / ufw which write /etc/passwd, /etc/shadow,
# /etc/ufw/user.rules. ProtectSystem=true is the right level for a
# system-administration daemon — it still protects the highest-value
# attacker target (/usr) while allowing legitimate /etc updates.
ProtectSystem=true
ProtectHome=read-only
ReadWritePaths=/var/log /var/spool/postfix /var/mail /home /run/dovecot-webadmin -/var/lib/ufw

# Network — the helper itself only uses AF_UNIX, but postqueue (spawned for
# queue inspection / flush / delete) probes AF_INET/AF_INET6 at startup even
# when Postfix is configured ipv4-only. Blocking those families makes every
# postqueue call log "inet_protocols: disabling IPv4 ... Address family not
# supported by protocol". Allow them so the probe succeeds silently; the
# helper never opens listening sockets.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

# System call filter — block exotic syscalls that the helper should never use.
# Note: we can't use ~@privileged because in systemd 250+ it includes @chown,
# which the helper legitimately needs at startup to set group ownership on
# /run/dovecot-webadmin/helper.sock so dwa-web can connect. Instead we list
# the dangerous subgroups individually.
SystemCallFilter=@system-service
SystemCallFilter=~@clock @module @reboot @swap @raw-io @mount @debug @cpu-emulation @obsolete @resources
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
